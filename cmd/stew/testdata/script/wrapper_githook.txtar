# The pre-commit hook runs through the wrapper, so the command gets the wrapper's environment.
[!exec:git] skip 'git not installed'
exec chmod 755 bin/wrap-env
exec git init -q
stew git install pre-commit
exec git add -A
env PATH=$WORK/bin:$PATH
exec git commit -q -m first
stderr '^==> core: ci\.quick \.\.\. done'

-- .stew/config.toml --
workspace_wrapper = "wrap-env {{STEW_STEP}}"
workspace_trust = ""
-- .stew/.gitignore --
runs/
-- .stew/projects.toml --
projects = ["core"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
project_trust = ""
[setup]
run = ""
[build]
run = ""
requires = ["core:setup"]
[ci.quick]
run = 'test "$FROM_WRAPPER" = yes'
requires = ["core:build"]
[ci.pre-commit]
run = ""
requires = ["core:ci.quick"]
-- bin/wrap-env --
#!/bin/sh
FROM_WRAPPER=yes exec "$@"
