# The spec's worked example: api:build fails. Only sections that directly require it print a blocked line;
# web:e2e requires only blocked sections, so it prints nothing, yet its summary cell is blocked.
# Durations and the run ID vary, so they are normalized before comparing the whole output.
! stew run 'web:e2e' 'api:test' 'docs:build' 'core:lint'
cp stdout out
status 1
exec sh -c 'sed -E -e "s/\(([0-9]+h)?([0-9]+m)?[0-9.]+s\)/(T)/" -e "s/^total: .*/total: T/" -e "s#runs/.*#runs/ID#" out'
cmp stdout want/out

# Only sections that ran a command have log files; blocked sections have none.
exec sh -c 'cd .stew/runs/* && ls'
cmp stdout want/files

# run.json records every blocked section with all its failed or blocked requirements.
exec sh -c 'cat .stew/runs/*/run.json'
stdout '"blocked_by": \[\s*"api:image",\s*"web:build"\s*\]'
stdout '"blocked_by": \[\s*"api:build",\s*"api:test"\s*\]'

# runs show applies the same pruning.
stew runs show latest
cp stdout out
exec sh -c 'sed -E -e "s/^run [^:]*:/run ID:/" -e "s/\(([0-9]+h)?([0-9]+m)?[0-9.]+s\)/(T)/" -e "s/^total: .*/total: T/" -e "s#runs/.*#runs/ID#" out'
cmp stdout want/show

# A section asked for by name prints its line with its whole blocked_by.
stew runs show latest 'web:e2e'
cp stdout out
exec sh -c 'sed -E -e "s/^run [^:]*:/run ID:/" out'
cmp stdout want/show-e2e

-- .stew/config.toml --
workspace_wrapper = ""
workspace_trust = ""
-- .stew/projects.toml --
projects = ["api", "core", "docs", "web"]
-- api/stew.toml --
name = "api"
project_wrapper = ""
project_trust = ""
[setup]
run = "true"
[build]
run = "echo boom; exit 1"
requires = ["api:setup", "core:build"]
[test]
run = "true"
requires = ["api:build"]
[image]
run = "true"
requires = ["api:build"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
project_trust = ""
[setup]
run = "true"
[lint]
run = "true"
[build]
run = "true"
requires = ["core:setup"]
-- docs/stew.toml --
name = "docs"
project_wrapper = ""
project_trust = ""
[build]
run = "true"
requires = ["core:build"]
-- web/stew.toml --
name = "web"
project_wrapper = ""
project_trust = ""
[build]
run = "true"
requires = ["api:build", "api:test"]
[e2e]
run = "true"
requires = ["api:image", "web:build"]
-- want/out --
