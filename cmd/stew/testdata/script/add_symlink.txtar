# Reaching the workspace through a symlink still records the real root-relative path.
[!symlink] skip 'symlinks unsupported'
cd real
stew init
cd $WORK
symlink link -> real
cd link/libs
stew add core
stdout '^added core \(libs/core\)$'
cmp $WORK/real/.stew/projects.toml $WORK/want/projects.toml

-- real/libs/core/.keep --
-- want/projects.toml --
projects = ["libs/core"]
