# stew runs list shows every run, newest first, with its local start time. Only root discovery is needed.
env TZ=Asia/Bangkok
stew runs list
cmp stdout want/table
! stderr .

# Porcelain: tab-separated, RFC 3339 local start time first, command last.
stew runs list --porcelain
cmp stdout want/porcelain

# --no-pager is accepted; without a terminal, output is never paged.
stew runs list --no-pager
cmp stdout want/table

# Arguments are usage errors.
! stew runs list latest
status 2

