# stew exec runs a command in the current directory. Without a project named, only the workspace wrapper applies,
# in the workspace root, even inside a project, and the command returns to the current directory, even one that
# needs shell quoting. Inherited run variables, as inside a section, are replaced, or cleared when stew exec does
# not set them. stdin reaches the command.
exec chmod 755 bin/wrap-ws bin/wrap-lib
env PATH=$WORK/bin:$PATH
env TMPDIR=$WORK/tmp
mkdir tmp
mkdir 'lib/my dir''s'
env STEW_ROOT=stale STEW_PROJECT=stale STEW_SECTION=stale
cd 'lib/my dir''s'

stdin $WORK/input.txt
exec stew exec 'echo "cwd=$(pwd) ws=$WS ws_cwd=$WS_CWD arg=$WS_ARG lib=$LIB root=$STEW_ROOT project=$STEW_PROJECT section=$STEW_SECTION"; cat'
stdout '^cwd='$WORK'/lib/my dir''s ws=yes ws_cwd='$WORK' arg='$WORK' lib= root='$WORK' project= section=$'
stdout '^hello from stdin$'
! stderr .

-- .stew/config.toml --
workspace_wrapper = 'wrap-ws "$STEW_ROOT" {{STEW_STEP}}'
workspace_trust = ""
-- .stew/projects.toml --
projects = ["lib"]
-- lib/stew.toml --
name = "lib"
project_wrapper = "wrap-lib {{STEW_STEP}}"
project_trust = ""
[setup]
run = "true"
-- input.txt --
hello from stdin
-- bin/wrap-ws --
#!/bin/sh
export WS=yes WS_ARG="$1" WS_CWD="$(pwd)"
shift
exec "$@"
-- bin/wrap-lib --
#!/bin/sh
[ "$WS" = yes ] || exit 9
export LIB=yes LIB_CWD="$(pwd)"
exec "$@"
