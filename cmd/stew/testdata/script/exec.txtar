# stew exec runs a command in the current directory. Wrappers run in the workspace root, or in the named project's
# directory, as for a section, and the command returns to the current directory.
exec chmod 755 bin/wrap-ws bin/wrap-lib
env PATH=$WORK/bin:$PATH
env TMPDIR=$WORK/tmp
mkdir tmp
exec stew exec 'echo "cwd=$(pwd) ws=$WS ws_cwd=$WS_CWD arg=$WS_ARG lib=$LIB root=$STEW_ROOT project=$STEW_PROJECT section=$STEW_SECTION"'
stdout '^cwd='$WORK' ws=yes ws_cwd='$WORK' arg='$WORK' lib= root='$WORK' project= section=$'
! stderr .

# Inherited run variables, as inside a section, are replaced, and cleared when stew exec does not set them.
env STEW_ROOT=stale STEW_PROJECT=stale STEW_SECTION=stale
exec stew exec lib 'echo "arg=$WS_ARG root=$STEW_ROOT project=$STEW_PROJECT section=$STEW_SECTION"'
stdout '^arg='$WORK' root='$WORK' project=lib section=$'

# Inside a project, without the project named, only the workspace wrapper applies, in the workspace root.
cd lib/src
exec stew exec 'echo "cwd=$(pwd) ws_cwd=$WS_CWD lib=$LIB project=$STEW_PROJECT"'
stdout '^cwd='$WORK'/lib/src ws_cwd='$WORK' lib= project=$'

# Naming the project nests its wrapper inside the workspace wrapper, both in the project directory.
exec stew exec lib 'echo "cwd=$(pwd) ws_cwd=$WS_CWD lib_cwd=$LIB_CWD project=$STEW_PROJECT"'
stdout '^cwd='$WORK'/lib/src ws_cwd='$WORK'/lib lib_cwd='$WORK'/lib project=lib$'
cd $WORK

# A current directory that needs shell quoting survives the round trip.
mkdir 'lib/my dir''s'
cd 'lib/my dir''s'
exec stew exec lib 'pwd'
stdout '^'$WORK'/lib/my dir''s$'

-- .stew/config.toml --
workspace_wrapper = 'wrap-ws "$STEW_ROOT" {{STEW_STEP}}'
-- .stew/projects.toml --
projects = ["lib"]
-- lib/stew.toml --
name = "lib"
project_wrapper = "wrap-lib {{STEW_STEP}}"
[setup]
run = "true"
-- lib/src/.keep --
-- bin/wrap-ws --
#!/bin/sh
export WS=yes WS_ARG="$1" WS_CWD="$(pwd)"
shift
exec "$@"
-- bin/wrap-lib --
#!/bin/sh
[ "$WS" = yes ] || exit 9
export LIB=yes LIB_CWD="$(pwd)"
exec "$@"
