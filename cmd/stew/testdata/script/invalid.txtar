# Invalid configuration exits 2, names the file and problem, and runs nothing.
cp bad/typo.toml core/stew.toml
exec sh -c 'stew build; echo "exit=$?"'
stdout '^exit=2$'
stderr 'core/stew.toml: \[build\]: unknown key "requries"'
! stdout '==>'
! exists .stew/runs

cp bad/dependencies.toml core/stew.toml
exec sh -c 'stew build; echo "exit=$?"'
stdout '^exit=2$'
stderr 'core/stew.toml: unknown key "dependencies"'

cp bad/cycle.toml core/stew.toml
exec sh -c 'stew build; echo "exit=$?"'
stdout '^exit=2$'
stderr 'cycle: api:build -> api:setup -> core:build -> core:setup -> api:build'

cp bad/missing.toml core/stew.toml
exec sh -c 'stew setup; echo "exit=$?"'
stdout '^exit=2$'
stderr '\[setup\]: missing key "run"'

rm core/stew.toml
exec sh -c 'stew add api; echo "exit=$?"'
stdout '^exit=2$'
stderr 'project "core": missing stew.toml'

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["api", "core"]
-- api/stew.toml --
name = "api"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build"]
[build]
run = ""
requires = ["api:setup"]
[ci.full]
run = ""
requires = ["api:build"]
-- core/.keep --
-- bad/typo.toml --
name = "core"
project_wrapper = ""
[setup]
run = ""
[build]
run = ""
requries = ["core:setup"]
-- bad/dependencies.toml --
name = "core"
dependencies = []
project_wrapper = ""
[setup]
run = ""
[build]
run = ""
requires = ["core:setup"]
-- bad/cycle.toml --
name = "core"
project_wrapper = ""
[setup]
run = ""
requires = ["api:build"]
[build]
run = ""
requires = ["core:setup"]
-- bad/missing.toml --
name = "core"
project_wrapper = ""
[setup]
skip_if = "true"
[build]
run = ""
requires = ["core:setup"]
