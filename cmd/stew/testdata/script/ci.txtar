# core defines full, quick, pre-commit (via quick), and pre-push (via full); api defines full, pre-commit, and
# pre-push; lib defines only full (empty). api:setup requires core:build.
# Durations and the run ID vary, so they are normalized before comparing.

# Naming api: core's sections run only as requirements, so core gets no CI.
stew ci api
! stdout '==> core: ci'
stdout '^==> api: ci\.full \.\.\. done \(\d+\.\ds\)$'
stdout '^│ core    │ skip  │ skip  │ -       │$'
stdout '^│ api     │ skip  │ skip  │ done    │$'

# A named project without the level fails its pattern; there is no fallback.
! stew ci api -l quick
stderr '^stew: pattern "api:ci\\\.quick" matches no section$'
! stdout .

# All projects, pre-commit level: only projects that define it run, in Kahn order.
stew ci --level pre-commit
cp stdout out
exec sh -c 'sed -E -e "s/\(([0-9]+h)?([0-9]+m)?[0-9.]+s\)/(T)/" -e "s/^total: .*/total: T/" -e "s#runs/.*#runs/ID#" out'
cmp stdout want/pre-commit
exec sh -c 'ls .stew/runs/*/core:ci.quick.stdout'

# pre-push requires full, skipping quick.
stew ci --level pre-push
stdout '^==> core: ci\.full \.\.\. done'
stdout '^==> core: ci\.pre-push \.\.\. skip'
stdout '^==> api: ci\.pre-push \.\.\. done'
! stdout 'ci\.quick'
! stdout '==> lib'
exec sh -c 'ls .stew/runs/*/api:ci.pre-push.stdout'

# Default level is full.
stew ci core
stdout '^==> core: ci\.full \.\.\. done'

# Failing CI exits 1.
stew ci api -l pre-commit --level pre-commit
cp want/api-failing.toml api/stew.toml
! stew ci api
stdout '^==> api: ci\.full \.\.\. fail'
stdout '^\(exit 1\)$'
status 1

# Usage errors exit 2 before anything runs.
! stew ci -l nightly
status 2
stderr '^stew: pattern "\.\*:ci\\\.nightly" matches no section$'
! stew ci nope
status 2
stderr 'unknown project "nope"'
! stdout '==>'

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["api", "core", "lib"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
[setup]
run = ""
[build]
run = ""
requires = ["core:setup"]
[ci.full]
run = "echo core-full"
requires = ["core:build"]
[ci.quick]
run = "echo core-quick"
requires = ["core:build"]
[ci.pre-commit]
run = ""
requires = ["core:ci.quick"]
[ci.pre-push]
run = ""
requires = ["core:ci.full"]
-- api/stew.toml --
name = "api"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build"]
[build]
run = ""
requires = ["api:setup"]
[ci.full]
run = "echo api-full"
requires = ["api:build"]
[ci.pre-commit]
run = "echo api-pre"
requires = ["api:build"]
[ci.pre-push]
run = "echo api-push"
requires = ["api:build"]
-- lib/stew.toml --
name = "lib"
project_wrapper = ""
[setup]
run = ""
[build]
run = ""
requires = ["lib:setup"]
[ci.full]
run = ""
requires = ["lib:build"]
-- want/api-failing.toml --
name = "api"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build"]
[build]
run = ""
requires = ["api:setup"]
[ci.full]
run = "exit 1"
requires = ["api:build"]
-- want/pre-commit --
==> core: setup ... skip (T)
==> core: build ... skip (T)
==> api: setup ... skip (T)
==> api: build ... skip (T)
==> api: ci.pre-commit ... done (T)
==> core: ci.quick ... done (T)
==> core: ci.pre-commit ... skip (T)
┌─────────┬───────┬───────┬───────────────┬──────────┐
│ project │ setup │ build │ ci.pre-commit │ ci.quick │
├─────────┼───────┼───────┼───────────────┼──────────┤
│ core    │ skip  │ skip  │ skip          │ done     │
│ api     │ skip  │ skip  │ done          │ -        │
└─────────┴───────┴───────┴───────────────┴──────────┘
total: T
logs: .stew/runs/ID
