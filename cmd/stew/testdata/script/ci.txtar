# core defines full+quick, api defines full+pre-commit, lib defines only full (empty). api depends on core.

# Naming api: core is a dependency only, so it gets setup+build but no CI.
exec stew ci api -l quick
! stdout '==> core: ci'
stdout '^==> api: ci\.quick -> ci\.full \.\.\. pass \(\d+\.\ds\)$'
stdout '^│ core    │ skip  │ skip  │ -           │$'
stdout '^│ api     │ skip  │ skip  │ pass \(full\) │$'

# All projects, pre-commit level: each falls back along pre-commit -> quick -> full.
exec stew ci --level pre-commit
stdout '^==> core: ci\.pre-commit -> ci\.quick \.\.\. pass'
stdout '^==> api: ci\.pre-commit \.\.\. pass'
stdout '^==> lib: ci\.pre-commit -> ci\.full \.\.\. skip'
exec sh -c 'ls .stew/runs/*/core-ci.quick.stdout'

# Default level is full.
exec stew ci core
stdout '^==> core: ci\.full \.\.\. pass'

# Failing CI exits 1.
exec sh -c 'stew ci api -l pre-commit --level pre-commit >/dev/null; echo "exit=$?"'
stdout '^exit=0$'
cp want/api-failing.toml api/stew.toml
exec sh -c 'stew ci api; echo "exit=$?"'
stdout '^==> api: ci\.full \.\.\. fail'
stdout '^\(exit 1\)$'
stdout '^exit=1$'

# Usage errors exit 2 before anything runs.
exec sh -c 'stew ci -l nightly; echo "exit=$?"'
stdout '^exit=2$'
stderr 'unknown CI level "nightly"'
exec sh -c 'stew ci nope; echo "exit=$?"'
stdout '^exit=2$'
stderr 'unknown project "nope"'
! stdout '==>'

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["api", "core", "lib"]
-- core/stew.toml --
name = "core"
dependencies = []
project_wrapper = ""
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = "echo core-full"
[ci.quick]
run = "echo core-quick"
-- api/stew.toml --
name = "api"
dependencies = ["core"]
project_wrapper = ""
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = "echo api-full"
[ci.pre-commit]
run = "echo api-pre"
-- lib/stew.toml --
name = "lib"
dependencies = []
project_wrapper = ""
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
-- want/api-failing.toml --
name = "api"
dependencies = ["core"]
project_wrapper = ""
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = "exit 1"
