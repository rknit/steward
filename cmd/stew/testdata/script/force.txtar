# A second stop signal while stew waits for an interrupted command SIGKILLs the command's process group.
# The command survives INT (its trap marks got-int) and ignores TERM.
# Loops are bounded (10s) so a regression fails instead of hanging the suite.
exec sh -c 'stew build > out 2>&1 & pid=$!; i=0; while [ ! -f core/started ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; kill -INT $pid; i=0; while [ ! -f core/got-int ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; kill -INT $pid; wait $pid; echo "exit=$?"'
stdout '^exit=130$'
exec cat out
stdout '^==> core: setup \.\.\. interrupted$'
stdout '^\(signal SIGKILL\)$'
stdout '^│ core    │ interrupted │ -     │$'
stdout '^total: '
! exists core/survived

# SIGTERM after Ctrl-C also forces the kill; the exit code still reflects the first signal.
rm core/started core/got-int
exec sh -c 'stew build > out 2>&1 & pid=$!; i=0; while [ ! -f core/started ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; kill -INT $pid; i=0; while [ ! -f core/got-int ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; kill -TERM $pid; wait $pid; echo "exit=$?"'
stdout '^exit=130$'
exec cat out
stdout '^\(signal SIGKILL\)$'
! exists core/survived

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["core"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
[setup]
run = "trap 'touch got-int' INT; trap '' TERM; touch started; i=0; while [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done; touch survived"
[build]
run = ""
requires = ["core:setup"]
[ci.full]
run = ""
requires = ["core:build"]
