# Run from a nested directory: stew walks up to find .stew/.
cd api/src
stdin $WORK/feed.txt
exec sh -c 'stew build; echo "exit=$?"'
cd $WORK

# Section lines in execution order; plain format (not a TTY), no escape codes.
stdout '^==> core: setup \.\.\. done \(\d+\.\ds\)$'
stdout '^==> core: build \.\.\. done \(\d+\.\ds\)$'
stdout '^==> api: setup \.\.\. skip \(\d+\.\ds\)$'
stdout '^==> api: build \.\.\. fail \(\d+\.\ds\)$'
! stdout '\x1b'

# Passing output is hidden; failing output is replayed with a marker and the exit code.
! stdout 'core-setup-out'
stdout '^--- stew: run: echo api-build-out; echo api-build-err >&2; exit 3$'
stdout '^api-build-out$'
stdout '^api-build-err$'
stdout '^\(exit 3\)$'
stdout '^exit=1$'

# Summary, total, and logs lines.
stdout '^│ core    │ done  │ done  │$'
stdout '^│ api     │ skip  │ fail  │$'
stdout '^total: \d+\.\ds$'
stdout '^logs: \.stew/runs/\d{8}T\d{6}Z-[0-9a-f]{4}$'

# Commands ran in the project dir, with stdin from /dev/null (not the fed file).
grep '/core$' core/where
exists core/artifact
exists core/stdin-got
! grep . core/stdin-got

# One run dir with a stdout/stderr/log triple per section that ran a command.
exec sh -c 'cd .stew/runs/* && ls'
cmp stdout want/files
exec sh -c 'cat .stew/runs/*/api:build.stdout'
cmp stdout want/api:build.stdout
exec sh -c 'cat .stew/runs/*/api:build.stderr'
cmp stdout want/api:build.stderr
exec sh -c 'cat .stew/runs/*/api:build.log'
stdout '^--- stew: run: echo api-build-out; echo api-build-err >&2; exit 3$'
stdout '^api-build-out$'
stdout '^api-build-err$'
exec sh -c 'cat .stew/runs/*/run.json'
stdout '"cause": "exit 3"'
stdout '"total_ms": \d+'

# Second run: skip_if passes, so core's sections skip.
stew build core
stdout '^==> core: setup \.\.\. skip \(\d+\.\ds\)$'
stdout '^==> core: build \.\.\. skip \(\d+\.\ds\)$'
! stdout '==> api'

# setup runs only setup.
stew setup core
stdout '^==> core: setup \.\.\. skip'
! stdout '==> core: build'
stdout '^│ project │ setup │$'

-- feed.txt --
this must not reach the command
-- .stew/config.toml --
workspace_wrapper = ""
workspace_trust = ""
-- .stew/projects.toml --
projects = ["api", "core"]
-- .stew/.gitignore --
runs/
-- core/stew.toml --
name = "core"
project_wrapper = ""
project_trust = ""

[setup]
skip_if = "test -f .setup-done"
run = "echo core-setup-out; pwd > where; touch .setup-done"
verify = "test -f .setup-done"

[build]
skip_if = "test -f artifact"
run = "cat > stdin-got; echo built > artifact"
verify = "test -f artifact"
requires = ["core:setup"]

[ci.full]
run = ""
requires = ["core:build"]
-- api/stew.toml --
name = "api"
project_wrapper = ""
project_trust = ""

[setup]
run = ""
requires = ["core:build"]

[build]
run = "echo api-build-out; echo api-build-err >&2; exit 3"
requires = ["api:setup"]

[ci.full]
run = ""
requires = ["api:build"]
-- api/src/.keep --
-- want/files --
api:build.log
api:build.stderr
api:build.stdout
core:build.log
core:build.stderr
core:build.stdout
core:setup.log
core:setup.stderr
core:setup.stdout
run.json
-- want/api:build.stdout --
--- stew: run: echo api-build-out; echo api-build-err >&2; exit 3
api-build-out
-- want/api:build.stderr --
--- stew: run: echo api-build-out; echo api-build-err >&2; exit 3
api-build-err
