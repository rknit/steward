# Loops are bounded (10s) so a regression fails instead of hanging the suite.
# SIGTERM reaches stew, which forwards it to the running command, stops, prints the summary, and exits 143.
exec sh -c 'stew build > out 2>&1 & pid=$!; i=0; while [ ! -f core/started ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; kill -TERM $pid; wait $pid; echo "exit=$?"'
stdout '^exit=143$'
exec cat out
stdout '^==> core: setup \.\.\. interrupted$'
stdout '^got-term$'
stdout '^│ core    │ interrupted │ -     │$'
stdout '^│ lib     │ -           │ -     │$'
stdout '^total: \d+\.\ds$'
stdout '^logs: \.stew/runs/\d{8}T\d{6}Z-[0-9a-f]{4}$'
! exists lib/ran
! exists core/survived

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["core", "lib"]
-- core/stew.toml --
name = "core"
dependencies = []
project_wrapper = ""
[setup]
run = "trap 'echo got-term; exit 1' TERM; touch started; i=0; while [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; touch survived"
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
-- lib/stew.toml --
name = "lib"
dependencies = []
project_wrapper = ""
[setup]
run = "touch ran"
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
