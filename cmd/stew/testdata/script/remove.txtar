# remove unregisters projects by name and keeps their stew.toml.
stew remove web
stdout '^removed web \(apps/web\)$'
! stderr .
cmp .stew/projects.toml want/projects-1.toml
exists apps/web/stew.toml

# Rejections change nothing: a remaining project still requires a section of a removed one (exit 1).
! stew remove core
status 1
stderr '^stew: cannot remove core: needed by api, tool$'
! stew remove core api
status 1
stderr '^stew: cannot remove core: needed by tool$'
! stderr 'cannot remove api'
! stew remove core steward
status 1
stderr '^stew: cannot remove core: needed by api, tool$'
stderr '^stew: cannot remove steward: needed by tool$'

# Unknown names and missing names are usage errors (exit 2).
! stew remove api cor
status 2
stderr '^stew: unknown project "cor"$'
! stew remove
status 2
cmp .stew/projects.toml want/projects-1.toml

# Several names, including a requires chain and a repeated name, are removed together, sorted by name.
# --clean deletes each stew.toml after the registry is written. The root project's path is ".".
stew remove tool core api steward api --clean
cmp stdout want/clean.txt
cmp .stew/projects.toml want/projects-2.toml
! exists libs/core/stew.toml
! exists services/api/stew.toml
! exists tools/x/stew.toml
! exists stew.toml
exists libs/core/.keep

-- want/clean.txt --
removed api (services/api)
removed core (libs/core)
removed steward (.)
removed tool (tools/x)
deleted services/api/stew.toml
deleted libs/core/stew.toml
deleted stew.toml
deleted tools/x/stew.toml
-- want/projects-1.toml --
projects = [".", "libs/core", "services/api", "tools/x"]
-- want/projects-2.toml --
projects = []
-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = [".", "apps/web", "libs/core", "services/api", "tools/x"]
-- libs/core/.keep --
-- stew.toml --
name = "steward"
project_wrapper = ""
[setup]
run = ""
[build]
run = ""
requires = ["steward:setup"]
[ci.full]
run = ""
requires = ["steward:build"]
-- libs/core/stew.toml --
name = "core"
project_wrapper = ""
[setup]
run = ""
[build]
run = ""
requires = ["core:setup"]
[ci.full]
run = ""
requires = ["core:build"]
-- services/api/stew.toml --
name = "api"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build"]
[build]
run = ""
requires = ["api:setup"]
[ci.full]
run = ""
requires = ["api:build"]
-- apps/web/stew.toml --
name = "web"
project_wrapper = ""
[setup]
run = ""
requires = ["api:build"]
[build]
run = ""
requires = ["web:setup"]
[ci.full]
run = ""
requires = ["web:build"]
-- tools/x/stew.toml --
name = "tool"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build", "steward:build"]
[build]
run = ""
requires = ["tool:setup"]
[ci.full]
run = ""
requires = ["tool:build"]
