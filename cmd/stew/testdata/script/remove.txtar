# remove unregisters projects by name and keeps their stew.toml.
exec stew remove web
stdout '^removed web \(apps/web\)$'
! stderr .
cmp .stew/projects.toml want/projects-1.toml
exists apps/web/stew.toml

# Rejections change nothing: a remaining project still depends on a removed one (exit 1).
exec sh -c 'stew remove core; echo "exit=$?"'
stdout '^exit=1$'
stderr '^stew: cannot remove core: needed by api, tool$'
exec sh -c 'stew remove core api; echo "exit=$?"'
stdout '^exit=1$'
stderr '^stew: cannot remove core: needed by tool$'
! stderr 'cannot remove api'
exec sh -c 'stew remove core steward; echo "exit=$?"'
stdout '^exit=1$'
stderr '^stew: cannot remove core: needed by api, tool$'
stderr '^stew: cannot remove steward: needed by tool$'

# Unknown names and missing names are usage errors (exit 2).
exec sh -c 'stew remove api cor; echo "exit=$?"'
stdout '^exit=2$'
stderr '^stew: unknown project "cor"$'
exec sh -c 'stew remove; echo "exit=$?"'
stdout '^exit=2$'
cmp .stew/projects.toml want/projects-1.toml

# Several names, including a dependency chain and a repeated name, are removed together, sorted by name.
# --clean deletes each stew.toml after the registry is written. The root project's path is ".".
exec stew remove tool core api steward api --clean
cmp stdout want/clean.txt
cmp .stew/projects.toml want/projects-2.toml
! exists libs/core/stew.toml
! exists services/api/stew.toml
! exists tools/x/stew.toml
! exists stew.toml
exists libs/core/.keep

-- want/clean.txt --
removed api (services/api)
removed core (libs/core)
removed steward (.)
removed tool (tools/x)
deleted services/api/stew.toml
deleted libs/core/stew.toml
deleted stew.toml
deleted tools/x/stew.toml
-- want/projects-1.toml --
projects = [".", "libs/core", "services/api", "tools/x"]
-- want/projects-2.toml --
projects = []
-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = [".", "apps/web", "libs/core", "services/api", "tools/x"]
-- libs/core/.keep --
-- stew.toml --
name = "steward"
dependencies = []
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
-- libs/core/stew.toml --
name = "core"
dependencies = []
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
-- services/api/stew.toml --
name = "api"
dependencies = ["core"]
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
-- apps/web/stew.toml --
name = "web"
dependencies = ["api"]
[setup]
run = ""
