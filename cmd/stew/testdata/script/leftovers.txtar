# When a step ends, stew stops what it left running in its process group.
# The SIGKILL fallback for a process that ignores SIGTERM is covered by the runner's unit tests,
# which use a short kill delay instead of stew's 5 s.
stew build
stdout '^==> lib: setup \.\.\. done'
exec sh -c 'kill -0 "$(cat lib/bg.pid)" 2>/dev/null && echo alive || echo gone'
stdout '^gone$'

-- .stew/config.toml --
workspace_wrapper = ""
workspace_trust = ""
-- .stew/projects.toml --
projects = ["lib"]
-- lib/stew.toml --
name = "lib"
project_wrapper = ""
project_trust = ""
[setup]
run = 'sleep 30 > /dev/null 2>&1 & echo $! > bg.pid'
[build]
run = ""
requires = ["lib:setup"]
[ci.full]
run = ""
requires = ["lib:build"]
