# stew runs show replays a run from .stew/runs. Hand-made fixture runs from 2026-01-01 sort before the real one.
# api:setup and webapi:setup require core:build; app:setup requires api:build. api's build fails, so app is blocked.
! stew build
status 1

# latest is the real run, not a fixture: a full page with every section's output, including output a passing section
# hides live. The fixtures below look runs up by exact ID.
# app:build requires only the blocked app:setup, so it prints no line; its summary cell is still blocked.
stew runs show latest
! stdout '20260101'
stdout '^run \d{8}T\d{6}Z-[0-9a-f]{4}: stew build$'
stdout '^==> core: setup \.\.\. done \(\d+\.\ds\)$'
stdout '^--- stew: run: echo core-setup-out$'
stdout '^core-setup-out$'
stdout '^==> core: build \.\.\. skip \(\d+\.\ds\)$'
stdout '^==> api: build \.\.\. fail \(\d+\.\ds\)$'
stdout '^api-build-err$'
stdout '^\(exit 3\)$'
stdout '^==> app: setup \.\.\. blocked by api:build$'
! stdout '==> app: build'
stdout '^webapi-setup-out$'
stdout '^│ app     │ blocked │ blocked │$'
stdout '^total: \d+\.\ds$'
stdout '^logs: \.stew/runs/\d{8}T\d{6}Z-[0-9a-f]{4}$'
! stdout '\x1b'

# Regexes match the whole <project>:<section> key; several are OR-ed; no summary with regexes.
stew runs show latest 'api:.*'
stdout '^==> api: setup \.\.\. skip'
stdout '^==> api: build \.\.\. fail'
! stdout 'webapi'
! stdout '^┌'
! stdout '^total:'
stew runs show latest api:build 'core:.*'
stdout '^==> core: setup'
stdout '^==> core: build'
stdout '^==> api: build'
! stdout '^==> api: setup'
! stew runs show latest api
status 1
stderr '^stew: no section matches$'

# A blocked section asked for by name prints its line, even when the full page hides it.
stew runs show latest 'app:build'
stdout '^==> app: build \.\.\. blocked by app:setup$'

# Porcelain: one tab-separated line per section; "-" for no duration or no log.
stew runs show latest --porcelain
stdout '^core\tsetup\tdone\t\d+\t\.stew/runs/\d{8}T\d{6}Z-[0-9a-f]{4}/core:setup\.log$'
stdout '^core\tbuild\tskip\t\d+\t-$'
stdout '^api\tbuild\tfail\t\d+\t\.stew/runs/\d{8}T\d{6}Z-[0-9a-f]{4}/api:build\.log$'
stdout '^app\tsetup\tblocked\t-\t-$'
stdout '^app\tbuild\tblocked\t-\t-$'
! stdout '==>'

# Errors.
! stew runs show latest '('
status 2
stderr 'missing closing \)'
! stew runs show 20000101T000000Z-0000
status 2
stderr '^stew: unknown run "20000101T000000Z-0000"$'
! stew runs show ../../etc
status 2
stderr '^stew: unknown run "\.\./\.\./etc"$'
! stew runs show 20260101T000000Z-0000
status 1
stderr '^stew: run 20260101T000000Z-0000 has no run\.json$'
! stew runs show 20260101T000002Z-0002
status 1
stderr '^stew: read run 20260101T000002Z-0002: invalid run\.json: section 0: unknown status "great"$'

# An unfinished run: the section without a record shows its partial log; total is unfinished.
stew runs show 20260101T000001Z-0001
cmp stdout want/unfinished

# A run from before sections: its phases are not read and a .log name without ":" is not an unfinished section,
# so the page is the header and a summary of "-" cells.
stew runs show 20260101T000003Z-0003
cmp stdout want/old

# The workspace is not validated, so logs stay readable while a stew.toml is broken.
cp want/broken.toml core/stew.toml
stew runs show latest --porcelain
stdout '^core\tsetup\tdone\t'

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["api", "app", "core", "webapi"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
[setup]
run = "echo core-setup-out"
[build]
run = ""
requires = ["core:setup"]
[ci.full]
run = ""
requires = ["core:build"]
-- api/stew.toml --
name = "api"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build"]
[build]
run = "echo api-build-out; echo api-build-err >&2; exit 3"
requires = ["api:setup"]
[ci.full]
run = ""
requires = ["api:build"]
-- app/stew.toml --
name = "app"
project_wrapper = ""
[setup]
run = "echo never"
requires = ["api:build"]
[build]
run = ""
requires = ["app:setup"]
[ci.full]
run = ""
requires = ["app:build"]
-- webapi/stew.toml --
name = "webapi"
project_wrapper = ""
[setup]
run = "echo webapi-setup-out"
requires = ["core:build"]
[build]
run = ""
requires = ["webapi:setup"]
[ci.full]
run = ""
requires = ["webapi:build"]
-- want/broken.toml --
name = "core"
-- .stew/runs/20260101T000000Z-0000/core:setup.stdout --
old run without a manifest
-- .stew/runs/20260101T000002Z-0002/run.json --
{"argv":["build"],"columns":["setup"],"projects":["core"],"sections":[{"project":"core","section":"setup","status":"great"}]}
-- .stew/runs/20260101T000001Z-0001/run.json --
{"argv":["ci","--level","pre-commit"],"columns":["setup","build","ci.quick","ci.pre-commit"],"projects":["core"],"sections":[{"project":"core","section":"setup","status":"skip","duration_ms":104},{"project":"core","section":"build","status":"done","duration_ms":2500}]}
-- .stew/runs/20260101T000001Z-0001/core:setup.log --
--- stew: skip_if: true
-- .stew/runs/20260101T000001Z-0001/core:build.log --
--- stew: run: make
built
-- .stew/runs/20260101T000001Z-0001/core:ci.quick.log --
--- stew: run: npm run lint
linting
-- .stew/runs/20260101T000003Z-0003/run.json --
{"argv":["build","api"],"columns":["setup","build"],"projects":["core","api"],"phases":[{"project":"core","phase":"setup","used":"setup","status":"done","duration_ms":100},{"project":"api","phase":"build","used":"build","status":"fail","duration_ms":200,"cause":"exit 1"}],"total_ms":300}
-- .stew/runs/20260101T000003Z-0003/core-setup.log --
--- stew: run: make setup
-- .stew/runs/20260101T000003Z-0003/api-build.log --
--- stew: run: make
(exit 1)
-- want/unfinished --
run 20260101T000001Z-0001: stew ci --level pre-commit
==> core: setup ... skip (0.1s)
--- stew: skip_if: true
==> core: build ... done (2.5s)
--- stew: run: make
built
==> core: ci.quick ... unfinished
--- stew: run: npm run lint
linting
┌─────────┬───────┬───────┬────────────┬───────────────┐
│ project │ setup │ build │ ci.quick   │ ci.pre-commit │
├─────────┼───────┼───────┼────────────┼───────────────┤
│ core    │ skip  │ done  │ unfinished │ -             │
└─────────┴───────┴───────┴────────────┴───────────────┘
total: unfinished
logs: .stew/runs/20260101T000001Z-0001
-- want/old --
run 20260101T000003Z-0003: stew build api
┌─────────┬───────┬───────┐
│ project │ setup │ build │
├─────────┼───────┼───────┤
│ core    │ -     │ -     │
│ api     │ -     │ -     │
└─────────┴───────┴───────┘
