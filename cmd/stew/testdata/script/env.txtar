# Every command gets STEW_* variables naming the run, the workspace root, and the phase that actually runs.
# Inherited values, e.g. from an outer stew run, are replaced.
env STEW_TAG=outer.build
env STEW_RUN_ID=outer
cd my.lib
exec stew ci --level pre-commit
cd $WORK

exec sh -c 'basename .stew/runs/*'
cp stdout id
exec sh -c 'printf "STEW_PHASE=setup\nSTEW_PROJECT=my.lib\nSTEW_ROOT=%s\nSTEW_RUN_ID=%s\nSTEW_TAG=my.lib.setup\n" "$WORK" "$(cat id)"'
cp stdout want-setup
cmp my.lib/setup.env want-setup
exec sh -c 'printf "STEW_PHASE=ci.full\nSTEW_PROJECT=my.lib\nSTEW_ROOT=%s\nSTEW_RUN_ID=%s\nSTEW_TAG=my.lib.ci.full\n" "$WORK" "$(cat id)"'
cp stdout want-ci
cmp my.lib/ci.env want-ci

-- .stew/projects.toml --
projects = ["my.lib"]
-- .stew/.gitignore --
runs/
-- my.lib/stew.toml --
name = "my.lib"
dependencies = []

[setup]
run = "env | grep ^STEW_ | sort > setup.env"
verify = ""

[build]
run = ""
verify = ""

[ci.full]
run = "env | grep ^STEW_ | sort > ci.env"
