# Every command gets STEW_* variables naming the run, the workspace root, and the section it runs.
# Inherited values, e.g. from an outer stew run, are replaced.
env STEW_TAG=outer:build
env STEW_RUN_ID=outer
cd my.lib
exec stew ci --level pre-commit
cd $WORK

exec sh -c 'basename .stew/runs/*'
cp stdout id
exec sh -c 'printf "STEW_PROJECT=my.lib\nSTEW_ROOT=%s\nSTEW_RUN_ID=%s\nSTEW_SECTION=setup\nSTEW_TAG=my.lib:setup\n" "$WORK" "$(cat id)"'
cp stdout want-setup
cmp my.lib/setup.env want-setup
exec sh -c 'printf "STEW_PROJECT=my.lib\nSTEW_ROOT=%s\nSTEW_RUN_ID=%s\nSTEW_SECTION=ci.quick\nSTEW_TAG=my.lib:ci.quick\n" "$WORK" "$(cat id)"'
cp stdout want-ci
cmp my.lib/ci.env want-ci

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["my.lib"]
-- .stew/.gitignore --
runs/
-- my.lib/stew.toml --
name = "my.lib"
project_wrapper = ""

[setup]
run = "env | grep ^STEW_ | sort > setup.env"

[build]
run = ""
requires = ["my.lib:setup"]

[ci.quick]
run = "env | grep ^STEW_ | sort > ci.env"
requires = ["my.lib:build"]

[ci.pre-commit]
run = ""
requires = ["my.lib:ci.quick"]
