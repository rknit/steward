# list prints every project as a table sorted by name, with the other projects its requires name, sorted.
stew list
cmp stdout want/table.txt
! stderr .

# --porcelain prints name, path, and comma-separated dependencies, tab-separated.
stew list --porcelain
cmp stdout want/porcelain.txt

# An empty workspace prints a hint; --porcelain prints nothing.
cd empty
stew list
stdout '^no projects \(add one with: stew add <path>\)$'
stew list --porcelain
! stdout .
cd $WORK

# Outside a workspace or with an invalid workspace, list exits 2.
cd /
! stew list
status 2
stderr '^stew: not a stew workspace$'
cd $WORK
rm libs/core/stew.toml
! stew list
status 2
stderr '^stew: project "libs/core": missing stew.toml$'

-- want/table.txt --
┌─────────┬──────────────┬──────────────┐
│ project │ path         │ dependencies │
├─────────┼──────────────┼──────────────┤
│ api     │ services/api │ core         │
│ core    │ libs/core    │ -            │
│ web     │ apps/web     │ api, core    │
└─────────┴──────────────┴──────────────┘
-- want/porcelain.txt --
api	services/api	core
core	libs/core	
web	apps/web	api,core
-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["apps/web", "libs/core", "services/api"]
-- empty/.stew/config.toml --
workspace_wrapper = ""
-- empty/.stew/projects.toml --
projects = []
-- libs/core/stew.toml --
name = "core"
project_wrapper = ""
[setup]
run = ""
[build]
run = ""
requires = ["core:setup"]
[ci.full]
run = ""
requires = ["core:build"]
-- services/api/stew.toml --
name = "api"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build"]
[build]
run = ""
requires = ["api:setup"]
[ci.full]
run = ""
requires = ["api:build"]
-- apps/web/stew.toml --
name = "web"
project_wrapper = ""
[setup]
run = ""
requires = ["core:build", "api:build"]
[build]
run = ""
requires = ["web:setup"]
[ci.full]
run = ""
requires = ["web:build"]
