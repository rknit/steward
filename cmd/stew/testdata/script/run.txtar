# stew run selects by regex and pulls in requires; aliases quote project names.
# Durations and the run ID vary, so they are normalized before comparing.
stew run api:build
cp stdout out
exec sh -c 'sed -E -e "s/\(([0-9]+h)?([0-9]+m)?[0-9.]+s\)/(T)/" -e "s/^total: .*/total: T/" -e "s#runs/.*#runs/ID#" out'
cmp stdout want/api-build
stew build my.lib
cp stdout out
exec sh -c 'sed -E -e "s/\(([0-9]+h)?([0-9]+m)?[0-9.]+s\)/(T)/" -e "s/^total: .*/total: T/" -e "s#runs/.*#runs/ID#" out'
cmp stdout want/mylib-build
stew run 'api:.*' '.*:build'
stdout -count=1 '^==> api: build \.\.\. done'

# A pattern that matches nothing is exit 2 before anything runs.
! stew run 'web:build'
stderr '^stew: pattern "web:build" matches no section$'
! stew ci --level pre-commit
stderr '^stew: pattern "\.\*:ci\\\.pre-commit" matches no section$'
! stew build web
stderr '^stew: unknown project "web"$'
! stew ci -l 'a b'
status 2
stderr '^stew: invalid CI level "a b"$'
! stew run '('
status 2
stderr '^stew: error parsing regexp'
! stew run
stderr 'requires at least 1 arg'

# A custom level is just a section name.
stew ci -l lint core
stdout '^==> core: ci.lint \.\.\. done'

-- .stew/config.toml --
workspace_wrapper = ""
workspace_trust = ""
-- .stew/projects.toml --
projects = ["api", "core", "mylib", "myxlib"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
project_trust = ""
[setup]
run = "true"
[build]
run = "true"
requires = ["core:setup"]
[ci.lint]
run = "true"
-- api/stew.toml --
name = "api"
project_wrapper = ""
project_trust = ""
[build]
run = "true"
requires = ["core:build"]
-- mylib/stew.toml --
name = "my.lib"
project_wrapper = ""
project_trust = ""
[build]
run = "true"
-- myxlib/stew.toml --
name = "myxlib"
project_wrapper = ""
project_trust = ""
[build]
run = "true"
-- want/api-build --
