# Loops are bounded (10s) so a regression fails instead of hanging the suite.
# SIGINT reaches stew, which forwards it to the running command, stops, prints the summary, and exits 130.
exec sh -c 'stew build > out 2>&1 & pid=$!; i=0; while [ ! -f core/started ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; kill -INT $pid; wait $pid; echo "exit=$?"'
stdout '^exit=130$'
exec cat out
stdout '^==> core: setup \.\.\. interrupted$'
stdout '^got-int$'
stdout '^│ core    │ interrupted │ -     │$'
stdout '^│ lib     │ -           │ -     │$'
! exists lib/ran

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["core", "lib"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
[setup]
run = "trap 'echo got-int; exit 1' INT; touch started; i=0; while [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done"
[build]
run = ""
requires = ["core:setup"]
[ci.full]
run = ""
requires = ["core:build"]
-- lib/stew.toml --
name = "lib"
project_wrapper = ""
[setup]
run = "touch ran"
[build]
run = ""
requires = ["lib:setup"]
[ci.full]
run = ""
requires = ["lib:build"]
