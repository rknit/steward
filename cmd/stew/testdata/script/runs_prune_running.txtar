# Loops are bounded (10s) so a regression fails instead of hanging the suite.
# A run in progress holds its lock: prune keeps it, even with --keep-last-n 0.
exec sh -c 'stew build core > out 2>&1 & pid=$!; i=0; while [ ! -f core/started ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; stew runs prune --keep-last-n 0; touch core/release; wait $pid; echo "exit=$?"'
stdout '^kept \d{8}T\d{6}Z-[0-9a-f]{4}: running$'
! stdout pruned
stdout '^exit=0$'

# stew killed mid-run with SIGKILL runs no cleanup. The kernel still drops the lock:
# the run stays unfinished, its orphaned command keeps running, and prune deletes the run.
rm core/started
rm core/release
exec sh -c 'stew build core > out 2>&1 & pid=$!; i=0; while [ ! -f core/started ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done; kill -KILL $pid; wait $pid; echo "exit=$?"'
stdout '^exit=137$'
exec stew runs list --porcelain
stdout '\tunfinished\t'
exec stew runs prune --keep-last-n 0
stdout '^pruned \d{8}T\d{6}Z-[0-9a-f]{4}$'
! stdout kept
exec touch core/release

# A process that left the step's process group before the step ended outlives the step,
# and it does not pass the lock on: once stew exits, the run is pruned while that process lives.
[!exec:setsid] stop 'setsid not installed'
exec stew build bg
exec sh -c 'test -s bg/pid && kill -0 "$(cat bg/pid)" && echo alive'
stdout '^alive$'
exec stew runs prune --keep-last-n 0
stdout '^pruned \d{8}T\d{6}Z-[0-9a-f]{4}$'
! stdout kept
exec touch bg/release

-- .stew/config.toml --
workspace_wrapper = ""
-- .stew/projects.toml --
projects = ["bg", "core"]
-- core/stew.toml --
name = "core"
dependencies = []
project_wrapper = ""
[setup]
run = "touch started; i=0; while [ ! -f release ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done"
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
-- bg/stew.toml --
name = "bg"
dependencies = []
project_wrapper = ""
[setup]
run = "setsid sh -c 'echo $$ > pid; i=0; while [ ! -f release ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done' > /dev/null 2>&1 & i=0; while [ ! -s pid ] && [ $i -lt 200 ]; do sleep 0.05; i=$((i+1)); done"
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
