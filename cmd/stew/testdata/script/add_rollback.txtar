# If the registry cannot be written, add removes the stew.toml it wrote and keeps one that already existed.
[root] skip 'root ignores directory permissions'
stew init
chmod 0555 .stew
! stew add libs/core
status 1
stderr 'register libs/core'
! exists libs/core/stew.toml
! stew add libs/pre
chmod 0755 .stew
status 1
! stdout 'using existing'
stderr 'register libs/pre'
cmp libs/pre/stew.toml want/pre.toml
cmp .stew/projects.toml want/projects.toml

-- want/projects.toml --
projects = []
-- libs/core/.keep --
-- libs/pre/stew.toml --
name = "pre"
project_wrapper = ""
project_trust = ""
[setup]
run = ""
[build]
run = ""
requires = ["pre:setup"]
[ci.full]
run = ""
requires = ["pre:build"]
-- want/pre.toml --
name = "pre"
project_wrapper = ""
project_trust = ""
[setup]
run = ""
[build]
run = ""
requires = ["pre:setup"]
[ci.full]
run = ""
requires = ["pre:build"]
