# If the registry cannot be written, add removes the stew.toml it wrote and keeps one that already existed.
[root] skip 'root ignores directory permissions'
exec stew init
chmod 0555 .stew
exec sh -c 'stew add libs/core; echo "exit=$?"'
stdout '^exit=1$'
stderr 'register libs/core'
! exists libs/core/stew.toml
exec sh -c 'stew add libs/pre; echo "exit=$?"'
chmod 0755 .stew
stdout '^exit=1$'
! stdout 'using existing'
stderr 'register libs/pre'
cmp libs/pre/stew.toml want/pre.toml
cmp .stew/projects.toml want/projects.toml

-- want/projects.toml --
projects = []
-- libs/core/.keep --
-- libs/pre/stew.toml --
name = "pre"
dependencies = []
project_wrapper = ""
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
-- want/pre.toml --
name = "pre"
dependencies = []
project_wrapper = ""
[setup]
run = ""
verify = ""
[build]
run = ""
verify = ""
[ci.full]
run = ""
