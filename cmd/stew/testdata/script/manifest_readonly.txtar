# A run.json save that fails at section end turns that section into a log error failure.
# core's setup makes the run directory read-only while it runs.
[root] skip 'root ignores directory permissions'
! stew build
cp stdout out
cp stderr err
exec sh -c 'chmod 0755 .stew/runs/*'
status 1
grep '^==> core: setup \.\.\. fail \(\d+\.\ds\)$' out
grep '^\(log error: .*permission denied\)$' out
grep '^==> core: build \.\.\. blocked by core:setup$' out
! grep '==> app' out
grep '^│ app     │ blocked │ blocked │$' out
grep '^stew: log error: .*permission denied$' err

-- .stew/config.toml --
workspace_wrapper = ""
workspace_trust = ""
-- .stew/projects.toml --
projects = ["app", "core"]
-- core/stew.toml --
name = "core"
project_wrapper = ""
project_trust = ""
[setup]
run = "chmod 0555 ../.stew/runs/*"
[build]
run = ""
requires = ["core:setup"]
[ci.full]
run = ""
requires = ["core:build"]
-- app/stew.toml --
name = "app"
project_wrapper = ""
project_trust = ""
[setup]
run = "echo never"
requires = ["core:build"]
[build]
run = ""
requires = ["app:setup"]
[ci.full]
run = ""
requires = ["app:build"]
