# latest with no runs is an unknown run.
! stew runs show latest
status 2
stderr '^stew: unknown run "latest"$'

# runs list with no runs: a message, or nothing with --porcelain.
stew runs list
stdout '^no runs$'
stew runs list --porcelain
! stdout .

# runs prune with no runs directory prints nothing.
stew runs prune --keep-last-n 0
! stdout .
! stderr .

# An unknown subcommand of a command group is a usage error; bare "runs" prints help and exits 0.
! stew runs shw latest
status 2
stderr '^stew: unknown command "shw" for "stew runs"$'
stew runs
stdout '^Usage:$'

-- .stew/config.toml --
workspace_wrapper = ""
workspace_trust = ""
-- .stew/projects.toml --
projects = []
